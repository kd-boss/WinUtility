#include "Resource.h"
#include "windows.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "LineDemo.manifest"

IDI_SMALL ICON "small.ico"
IDI_LINEDEMO ICON "LineDemo.ico"

IDC_LINEDEMO MENU
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
{
  POPUP "&File"
  {
    MENUITEM "E&xit",  IDM_EXIT
  }
  POPUP "&Help"
  {
    MENUITEM "&About ...",  IDM_ABOUT
  }
}

IDD_ABOUTBOX DIALOGEX 0,0,250,90
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About LineDemo"
FONT 8, "Ms Shell Dlg",0 ,0,0x1
{
   ICON IDI_SMALL,IDC_STATIC,14,14,20,20
   LTEXT "LineDemo Verion 1.0",IDC_STATIC,42,14,200,8,SS_NOPREFIX
   LTEXT "Copyright MIT Liscense",IDC_STATIC,42,26,200,8,SS_NOPREFIX
   LTEXT "An example application for the WinUtility library",IDC_STATIC,42,39,240,8
   LTEXT "Modern LINEDEMO.c by Petzold, using C++, and Direct 2D",IDC_STATIC,42,52,240,8,SS_NOPREFIX
   DEFPUSHBUTTON "O&K",IDOK,100,66,50,14,WS_GROUP
}

IDC_LINEDEMO ACCELERATORS
{
  "?", IDM_ABOUT, ASCII, ALT
  "/", IDM_ABOUT, ASCII, ALT
  "x", IDM_EXIT,  ASCII, ALT
}

STRINGTABLE
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
{
  IDC_LINEDEMO, 	"LINEDEMO"
  IDS_APP_TITLE, 	"LineDemo"
}

IDI_LINEDEMO ICON "LineDemo.ico"
IDI_SMALL ICON "small.ico"

1 TEXTINCLUDE
{
  "Resource.h\0"
}

VS_VERSION_INFO    VERSIONINFO
FILEVERSION        1,0,0,0
PRODUCTVERSION     1,0,0,0
FILEFLAGSMASK      VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
  FILEFLAGS        VS_FF_DEBUG | VS_FF_PRERELEASE
#else
  FILEFLAGS        0
#endif
FILEOS             VOS_NT_WINDOWS32
FILETYPE           VFT_APP
FILESUBTYPE        VFT2_UNKNOWN
{
  BLOCK "StringFileInfo"
  {
    BLOCK "040904E4"
    {
      VALUE "CompanyName", "kd.boss@gmail.com"
      VALUE "FileDescription", "Win32 LineDemo application"
      VALUE "FileVersion", "1.0.0.0"
      VALUE "InternalName", "LineDemo"
      VALUE "LegalCopyright", "MIT"
      VALUE "OriginalFilename", "LineDemo.exe"
      VALUE "ProductName", "Win32 LineDemo application"
      VALUE "ProductVersion", "1.0.0.0"
    }
  }
  BLOCK "VarFileInfo"
  {
        VALUE "Translation", 0x409, 1252
  }
}
#include "resource.h"
#include "windows.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "DEVICECAPS1.exe.manifest"

/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.

IDI_DEVICECAPS1       ICON         "DEVICECAPS1.ico"
IDI_SMALL         ICON         "small.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDC_DEVICECAPS1 MENU
{
    POPUP "&File"
    {
        MENUITEM "E&xit",                IDM_EXIT
    }
    POPUP "&Help"
    {
        MENUITEM "&About ...",           IDM_ABOUT
    }
}


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDC_DEVICECAPS1 ACCELERATORS
{
    "?",            IDM_ABOUT,              ASCII,  ALT
    "/",            IDM_ABOUT,              ASCII,  ALT
	"x",			IDM_EXIT, 				ASCII,  ALT
}


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 0, 0, 280, 100
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About DEVICECAPS1"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
{
    ICON            IDI_SMALL,IDC_STATIC,14,14,21,20
    LTEXT           "DEVICECAPS1, Version 1.0",IDC_STATIC,42,14,114,8,SS_NOPREFIX
    LTEXT           "Copyright MIT Liscense",IDC_STATIC,42,26,114,8
	LTEXT			"An example application for the WinUtility Libary, DEVICECAPS1.c app by Petzold", IDC_STATIC, 7,48,260,16
    
    DEFPUSHBUTTON   "O&K",IDOK,213,66,50,14,WS_GROUP
}

1 TEXTINCLUDE 
{
    "resource.h\0"
}

2 TEXTINCLUDE 
{
    "#ifndef APSTUDIO_INVOKED\r\n"
    "#include ""targetver.h""\r\n"
    "#endif\r\n"
    "#define APSTUDIO_HIDDEN_SYMBOLS\r\n"
    "#include ""windows.h""\r\n"
    "#undef APSTUDIO_HIDDEN_SYMBOLS\r\n"
    "\0"
}

3 TEXTINCLUDE 
{
    "\r\n"
    "\0"
}


/////////////////////////////////////////////////////////////////////////////
//
// String Table
//

STRINGTABLE
{
   IDC_DEVICECAPS1         "DEVICECAPS1"
   IDS_APP_TITLE       "DEVICECAPS1"
}

// Executable version information.
VS_VERSION_INFO    VERSIONINFO
FILEVERSION        1,0,0,0
PRODUCTVERSION     1,0,0,0
FILEFLAGSMASK      VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
  FILEFLAGS        VS_FF_DEBUG | VS_FF_PRERELEASE
#else
  FILEFLAGS        0
#endif
FILEOS             VOS_NT_WINDOWS32
FILETYPE           VFT_APP
FILESUBTYPE        VFT2_UNKNOWN
{
  BLOCK "StringFileInfo"
  {
    BLOCK "040904E4"
    {
      VALUE "CompanyName", "kd.boss@gmail.com"
      VALUE "FileDescription", "DEVICECAPS1 application"
      VALUE "FileVersion", "1.0.0.0"
      VALUE "InternalName", "DEVICECAPS1"
      VALUE "LegalCopyright", "MIT"
      VALUE "OriginalFilename", "DEVICECAPS1.exe"
      VALUE "ProductName", "DEVICECAPS1 application"
      VALUE "ProductVersion", "1.0.0.0"
    }
  }
  BLOCK "VarFileInfo"
  {
	VALUE "Translation", 0x409, 1252
  }
}
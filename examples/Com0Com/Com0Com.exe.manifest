<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0" xmlns:asmv3="urn:schemas-microsoft-com:asm.v3">
  
  <!-- 1. OS Compatibility: Tells Windows this app is tested for Win 10/11 -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 use the same GUID -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>

  <!-- 2. Windows Settings: High DPI and Long Paths -->
  <asmv3:application>
    <asmv3:windowsSettings>
      <!-- Enables Per-Monitor DPI Awareness V2 (Recommended for Win 11) -->
      <dpiAwareness xmlns="http://schemas.microsoft.com">PerMonitorV2</dpiAwareness>
      <!-- Fallback for older Windows 10 versions -->
      <dpiAware xmlns="http://schemas.microsoft.com">true/PM</dpiAware>
      <!-- Removes the 260-character limit for file paths -->
      <longPathAware xmlns="http://schemas.microsoft.com">true</longPathAware>
    </asmv3:windowsSettings>
  </asmv3:application>

  <!-- 3. Security: Defines UAC execution level -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>

</assembly>
